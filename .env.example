# AI Navigation Hub — destination URLs
#
# Copy this file to `.env` and fill in the real values. Only vars prefixed with
# VITE_ are exposed to the browser.
#
# IMPORTANT: Vite inlines these values into the JS bundle at build time. They are
# plaintext in the shipped assets and readable by anyone who can load the page.
# Never put a token, key, or credential here. Changing a URL needs a rebuild.
#
# Leave a var blank (or delete the line) and that tool still appears on the page
# as a "Coming soon" card instead of becoming a dead link.

# --- Conversational Analytics ---
VITE_URL_CHATBOT_ANALYTICS=https://google.com
VITE_URL_VOICEBOT_ANALYTICS=https://google.com
VITE_URL_EMAILBOT_ANALYTICS=https://google.com

# --- Agent Workbench ---
VITE_URL_MCP_WORKSPACE=https://google.com
VITE_URL_QA_AGENT=https://google.com

# --- Operations & Intelligence ---
VITE_URL_OUTBOUND_CALLER=https://google.com
VITE_URL_REPRICER_PORTAL=https://google.com
VITE_URL_NEWSLETTER=https://google.com
